---
layout: page
---
{{ content }}

{% if page.collection and page.collection.size > 0 %}
  {% assign collection = site[page.collection] | sort: 'roasted' | reverse %}
  {% if collection and collection.size > 0 %}
    {% for item in collection %}
      {% assign item_date = item.roasted | default: item.date %}
      {% assign current_year = item_date | date: '%Y' %}
      {% if current_year != year %}
        {% unless forloop.first %}
          </ul>
        {% endunless %}
        <h1 id="y{{ current_year }}">
          <a href="{{ current_year | prepend: '/coffee/' | relative_url }}">{{ current_year }}</a>
        </h1>
        <ul>
          {% assign year = current_year %}
      {% endif %}

      <figure class="cover">
        <a class="cover-link" href="{{ item.url | relative_url }}">
          {% if item.cover %}
            {% assign cover_prefix = item.cover | slice: 0, 4 %}
            {% if cover_prefix == 'http' %}
              <img alt="{{ item.title }} cover" src="{{ item.cover }}" style="height:200px">
            {% else %}
              <img alt="{{ item.title }} cover" src="{{ item.cover | prepend: page.covers | relative_url }}" style="height:200px">
            {% endif %}
          {% endif %}
          {% if item.stars %}
            <figcaption class="stars-overlay">
              {% assign full_stars = item.stars | floor %}
              {% assign half_star = item.stars | minus: full_stars %}
              {% assign empty_stars = 5 | minus: full_stars %}
              {% if half_star > 0 %}
                {% assign empty_stars = empty_stars | minus: 1 %}
              {% endif %}
              {% for i in (1..full_stars) -%}
                <i class="fa-solid fa-star fa-sm"></i>
              {%- endfor -%}
              {%- if half_star > 0 %}<i class="fa-solid fa-star-half-stroke fa-sm"></i>{% endif -%}
              {%- for i in (1..empty_stars) -%}
                <i class="fa-regular fa-star fa-sm"></i>
              {%- endfor -%}
            </figcaption>
          {% endif %}
        </a>
      </figure>
      {% if forloop.last %}
        </ul>
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}
